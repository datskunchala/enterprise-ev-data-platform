
digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.5", labelloc="t", label="Implementation / Execution Flow", fontsize=18, fontname="Arial"];
 node [shape=box, style="rounded,filled", fillcolor="#eaf2f8", color="#315b7d", fontname="Arial", fontsize=10, margin="0.16,0.12"];
 edge [color="#315b7d", arrowsize=0.8];
 A [label="1. Trigger ADF pipeline", fillcolor="#d5e8d4", color="#548235"];
 B [label="2. Bronze notebook\nRead source / write raw"];
 C [label="3. Silver notebook\nValidate / standardize"];
 D [label="4. Gold notebook\nBuild reporting outputs"];
 E [label="5. Cost & audit notebook\nWrite control metrics"];
 F [label="6. Verify SQL counts\nand KPI totals"];
 G [label="7. Refresh Power BI\nExport PDF"];
 A -> B -> C -> D -> E -> F -> G;
}
